# Copy to .env.development.local for local work. On Vercel, set these in
# Project Settings -> Environment Variables instead (never commit real values).

# Local only (Vercel assigns its own port)
PORT=5500

# Supabase -> Project Settings -> API. The service key bypasses RLS: keep it server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS (localhost:5173 is always allowed)
CORS_ORIGINS=https://your-frontend-domain.com
